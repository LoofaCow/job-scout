# Ollama — local, no auth needed. Default port is 11434.
OLLAMA_BASE_URL=http://localhost:11434

# Featherless — OpenAI-compatible. Get key from featherless.ai dashboard.
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# NanoGPT — OpenAI-compatible. Get key from nano-gpt.com.
NANOGPT_API_KEY=
NANOGPT_BASE_URL=https://nano-gpt.com/api/v1

# Database — SQLite file path. Relative to project root.
DATABASE_URL=sqlite:///./job_scout.db

# Default models per tier (we wire these into the router)
MODEL_LOCAL=qwen2.5:7b-instruct
MODEL_HEAVY=meta-llama/Meta-Llama-3.1-70B-Instruct
MODEL_FRONTIER=claude-sonnet-4-5